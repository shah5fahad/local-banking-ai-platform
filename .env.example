# ==============================================================================
# LOCAL BANKING AI PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and customize for your environment:
#   cp .env.example .env
# ==============================================================================

# ==============================================================================
# 1. COMMON / GLOBAL APPLICATION SETTINGS
# ==============================================================================
APP_ENV=development                         # development | test | production
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                             # json | text

# ==============================================================================
# 2. CORE BANKING SERVICE SETTINGS
# ==============================================================================
# Database URL (SQLite for local/docker; PostgreSQL for production)
# In Docker Compose: sqlite:////data/banking.db
# In local host development: sqlite:///./data/banking.db
BANKING_DATABASE_URL=sqlite:////data/banking.db

# Authentication, JWT & Secrets
BANKING_JWT_ALGORITHM=HS256                 # HS256 in dev; use RS256/EdDSA in production
BANKING_JWT_SECRET=change-me-min-32-chars-dev-only-not-prod
BANKING_SECRET_KEY=change-me-min-32-chars-dev-only-not-prod
BANKING_JWT_PRIVATE_KEY_PATH=               # Path to PEM private key (for RS256/EdDSA in prod)
BANKING_JWT_PUBLIC_KEY_PATH=                # Path to PEM public key (for RS256/EdDSA in prod)
ACCESS_TOKEN_EXPIRE_MINUTES=15              # Short-lived access token validity (minutes)
REFRESH_TOKEN_EXPIRE_DAYS=7                 # Refresh token lifetime (days)
PASSWORD_HASH_SCHEME=argon2                 # argon2 | bcrypt

# Data Encryption & Blind Indexing
# 32-byte base64-encoded key for AES-256-GCM encryption of sensitive fields (account numbers, cards)
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes
# Secret pepper for blind index HMAC hashing
ACCOUNT_HASH_PEPPER=change-me-pepper-secret

# Machine-to-Machine Service Authorization (comma-separated "service:key" pairs)
SERVICE_API_KEYS=ai-service:change-me-service-key

# Transaction Limits & Safety Thresholds
TRANSFER_PER_TXN_LIMIT_MINOR=20000000       # Per-transaction limit in minor units (paise) -> ₹2,00,000.00
TRANSFER_DAILY_LIMIT_MINOR=50000000         # Daily transfer limit in minor units (paise) -> ₹5,00,000.00
TRANSFER_APPROVAL_EXPIRY_SECONDS=300        # Transfer pending approval TTL (5 minutes)
DUPLICATE_WINDOW_SECONDS=120                # Duplicate transaction detection window (2 minutes)

# Transaction Authentication (MFA / Direct PIN)
TXN_AUTH_METHOD=PIN                         # PIN | OTP | PIN_AND_OTP
TXN_AUTH_MAX_ATTEMPTS=5                     # Maximum failed PIN attempts before account lockout

# Security Rate Limiting & CORS
RATE_LIMIT_LOGIN=5/minute
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ==============================================================================
# 3. AI CHAT & ORCHESTRATION SERVICE SETTINGS
# ==============================================================================
# Database URL (SQLite for local/docker; separate DB volume from banking)
# In Docker Compose: sqlite:////data/ai.db
# In local host development: sqlite:///./data/ai.db
AI_DATABASE_URL=sqlite:////data/ai.db
DATABASE_URL=sqlite:////data/ai.db

# LangGraph SQLite Checkpointer DB Path (persists workflow states during HITL interrupts)
LANGGRAPH_CHECKPOINT_DB=/data/checkpoints.db

# Core Banking Service Integration
# In Docker Compose: http://banking:8001/api/v1
# In local host development: http://localhost:8001/api/v1
AI_BANKING_SERVICE_URL=http://banking:8001/api/v1
BANKING_SERVICE_URL=http://banking:8001/api/v1
BANKING_API_BASE_URL=http://banking:8001/api/v1
BANKING_API_TIMEOUT_SECONDS=10

# AI Service Identity Key (must match SERVICE_API_KEYS entry in Banking Service)
AI_SERVICE_KEY=ai-service:change-me-service-key
SERVICE_KEY=ai-service:change-me-service-key
BANKING_SERVICE_KEY=change-me-service-key

# AI Service Internal Secret Key & Algorithm (for service tokens & JWT validation)
AI_SECRET_KEY=change-me-min-32-chars-dev-only-not-prod
SECRET_KEY=change-me-min-32-chars-dev-only-not-prod
AI_ALGORITHM=HS256
ALGORITHM=HS256
BANKING_JWT_VERIFY_KEY=change-me-min-32-chars-dev-only-not-prod

# LLM Provider & Hyperparameters
# Set to 'fake' for offline development / unit testing without API keys
# Set to 'openai' or 'anthropic' or 'ollama' for live LLM execution
AI_LLM_PROVIDER=google                      # fake | openai | anthropic | azure_openai | ollama
LLM_PROVIDER=google
AI_LLM_MODEL=gemini-3.6-flash                    # e.g., gpt-4o-mini, claude-3-5-sonnet-20241022, llama3
LLM_MODEL=gemini-3.6-flash
AI_LLM_API_KEY=your-openai-or-anthropic-api-key-here
LLM_API_KEY=your-openai-or-anthropic-api-key-here
LLM_BASE_URL=                               # Optional custom base URL (e.g., http://localhost:11434/v1 for Ollama)
AI_LLM_TEMPERATURE=0.0                      # 0.0 provides deterministic, factual banking responses
LLM_TEMPERATURE=0.0
AI_LLM_MAX_TOKENS=2048
LLM_MAX_TOKENS=2048

# Embeddings & Vector Store (RAG Pipeline)
AI_EMBEDDING_PROVIDER=google                # fake | openai | sentence-transformers | ollama
EMBEDDING_PROVIDER=google
AI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=                          # Leave blank if same as LLM_API_KEY

AI_VECTOR_STORE_PROVIDER=chroma             # memory | chroma | qdrant
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE=chroma
AI_VECTOR_STORE_PATH=/data/vectorstore      # Directory storing vector embeddings
VECTOR_STORE_PATH=/data/vectorstore

AI_RAG_TOP_K=6                              # Number of top chunks retrieved per policy query
RAG_TOP_K=6
AI_RAG_MIN_SCORE=0.30                       # Minimum cosine similarity threshold (0.0 to 1.0)
RAG_MIN_SCORE=0.30
CHUNK_SIZE_TOKENS=800                       # Chunk size in tokens for text splitter
CHUNK_OVERLAP_TOKENS=120                    # Overlap tokens between adjacent chunks

# Regulatory Document Ingestion
AI_UPLOAD_DIR=/data/uploads                 # Directory for ingested PDF/DOCX/TXT files
UPLOAD_DIR=/data/uploads
AI_MAX_UPLOAD_SIZE_MB=25                    # Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=25
MAX_UPLOAD_MB=25

# External Research (Search Engine Integration)
AI_SEARCH_PROVIDER=duckduckgo                   # none | tavily | duckduckgo | serpapi
SEARCH_PROVIDER=duckduckgo
AI_SEARCH_API_KEY=your-tavily-api-key-here
SEARCH_API_KEY=your-tavily-api-key-here
AI_SEARCH_ALLOWED_DOMAINS=rbi.org.in,sebi.gov.in,npci.org.in,incometax.gov.in,financialservices.gov.in
SEARCH_ALLOWED_DOMAINS=rbi.org.in,sebi.gov.in,npci.org.in,incometax.gov.in,financialservices.gov.in

# HITL Approval Expiry & Lifecycle Sweeper
AI_ENABLE_EXPIRY_SWEEPER=true               # Run background sweeper for expired pending approvals
ENABLE_EXPIRY_SWEEPER=true
AI_SWEEPER_INTERVAL_SECONDS=60              # Sweeper frequency in seconds
SWEEPER_INTERVAL_SECONDS=60
AI_CHECKPOINT_RETENTION_DAYS=7              # Retention days for stale checkpoints before auto-pruning
CHECKPOINT_RETENTION_DAYS=7

# Specific Workflow Approval Expirations (seconds)
APPROVAL_EXPIRY_TRANSFER_SECONDS=300        # Fund Transfer approval TTL (5 minutes)
APPROVAL_EXPIRY_CARD_PAYMENT_SECONDS=300    # Card payment approval TTL (5 minutes)
APPROVAL_EXPIRY_BENEFICIARY_SECONDS=600     # Beneficiary creation approval TTL (10 minutes)
APPROVAL_EXPIRY_LOAN_SECONDS=1800           # Loan application approval TTL (30 minutes)

# AI Chat Rate Limits
CHAT_RATE_LIMIT=20/minute

# ==============================================================================
# 4. STREAMLIT FRONTEND WEB APPLICATION SETTINGS
# ==============================================================================
# Service endpoints accessed by the frontend server
# In Docker Compose: http://banking:8001/api/v1 and http://ai:8002/api/v1
# In local host development: http://localhost:8001/api/v1 and http://localhost:8002/api/v1
BANKING_API_URL=http://banking:8001/api/v1
AI_API_URL=http://ai:8002/api/v1

# Security & Session Settings
SESSION_IDLE_TIMEOUT_MINUTES=15             # Automatic user logout after 15 minutes of inactivity
